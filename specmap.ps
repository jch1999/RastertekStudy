////////////////////////////////////////////////////////////////////////////////
// Filename: specmap.ps
////////////////////////////////////////////////////////////////////////////////

/////////////
// GLOBALS //
/////////////
Texture2D shaderTexture1 : register(t0);
Texture2D shaderTexture2 : register(t1);
Texture2D shaderTexture3 : register(t2);
SamplerState SampleType : register(s0);

cbuffer LightBuffer
{
	float4 diffuseColor;
	float4 specularColor;
	float specularPower;
	float3 lightDirection;
};

//////////////
// TYPEDEFS //
//////////////
struct PixelInputType
{
	float4 position : SV_POSITION;
	float2 tex : TEXCOORD0;
	float3 normal : NORMAL;
	float3 tangent : TANGENT;
	float3 binormal : BINORMAL;
	float3 viewDirection : TEXCOORD1;
};

////////////////////////////////////////////////////////////////////////////////
// Pixel Shader
////////////////////////////////////////////////////////////////////////////////
float4 SpecMapPixelShader(PixelInputType input) : SV_TARGET
{
	float4 textureColor;
	float4 bumpMap;
	float3 bumpNormal;
	float3 lightDir;
	float lightIntensity;
	float4 color;
	float4 specularIntensity;
	float3 reflection;
	float4 specular;
	
	// 이 위치에서 색 텍스처로부터 픽셀색을 샘플한다.
	textureColor = shaderTexture1.Sample(SampleType, input.tex);

	// 노멀 맵에서 픽셀을 샘플한다.
	bumpMap = shaderTexture2.Sample(SampleType, input.tex);

	// 법선 값의 범위를 (0, +1)에서 (-1, +1)로 확장한다.
	bumpMap = (bumpMap * 2.0f) - 1.0f;

	// 노멀 맵의 데이터로부터 법선을 계산한다.
	bumpNormal = (bumpMap.x * input.tangent) + (bumpMap.y * input.binormal) + (bumpMap.z * input.normal);

	// 결과 범프 법선을 정규화한다.
	bumpNormal = normalize(bumpNormal);

	// 계산을 위해 빛 방향을 반전한다.
	lightDir = -lightDirection;

	// 노멀 맵 값을 기준으로 이 픽셀에 가해지는 빛의 양을 계산한다.
	lightIntensity = saturate(dot(bumpNormal, lightDir));

	// 디퓨즈 색과 빛의 세기를 결합해 최종 디퓨즈 색의 양을 정한다.
	color = saturate(diffuseColor * lightIntensity);

	// 최종 빛 색을 텍스처색과 결합한다.
	color = color * textureColor;
	// color = 0.0f;
	if(lightIntensity > 0.0f)
	{
		// 스페큘러 맵 텍스처에서 이 픽셀을 샘플링한다.
		specularIntensity = shaderTexture3.Sample(SampleType, input.tex);
		// 빛의 세기, 법선 벡터, 빛 방향을 이용해 반사 벡터를 계산한다.
		reflection = normalize(2 * lightIntensity * bumpNormal - lightDir);

		// 반사 벡터, 시선 방향, specular power를 이용해 스페큘러 광량을 구한다.
		specular = pow(saturate(dot(reflection, input.viewDirection)), specularPower);
		// 스페큘러 맵으로 이 픽셀에서의 스페큘러 세기를 결정한다.
		specular = specular * specularIntensity;

		// 스페큘러 성분을 맨 마지막에 출력 색에 더한다.
		color = saturate(color + specular);
	}

	return color;
}